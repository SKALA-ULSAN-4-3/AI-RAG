# 실제 웹 검색 모드(SEARCH_MODE=live)에서만 필요합니다.
# mock 실행과 자동 테스트는 키 없이 동작합니다.
TAVILY_API_KEY=

# live | mock  (기본값: mock)
SEARCH_MODE=mock

# 기술 요약·분류: 실제 키는 .env에만 저장 (Git 제외).
OPENAI_API_KEY=
# 기술 요약·분류 모델: OpenAI GPT-4o mini.
OPENAI_MODEL=gpt-4o-mini
# 투자 판단 채점(LLM/Judge) 모델: 비우면 OPENAI_MODEL 사용.
OPENAI_JUDGE_MODEL=

# 로컬 임베딩: 내장 GPU에 의존하지 않는 CPU 기본값.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
# 검색 기준: 20개 기업의 기술 질문 점수 분포로 조정한 값 (정답셋 보정 아님).
RAG_MIN_SCORE=0.30
